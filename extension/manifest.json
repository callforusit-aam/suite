{
  "manifest_version": 3,
  "name": "Callforus Prospect",
  "version": "1.0.0",
  "description": "Estrae e qualifica i brand su Amazon.it e li salva nei Prospect Amazon di Callforus Outbound.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.amazon.it/*",
    "https://mxkasinotmqqqdcpidrn.supabase.co/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Callforus Prospect",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://www.amazon.it/*"],
      "js": ["config.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
